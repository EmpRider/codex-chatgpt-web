+    let session: CDPSession | undefined;
+    try {
+      const opening = page.context().newCDPSession(page);
+      void opening.then(late => {
+        if (generation !== this.generation) void bounded(late.detach()).catch(() => {});
+      }, () => {});
+      session = await bounded(opening);
